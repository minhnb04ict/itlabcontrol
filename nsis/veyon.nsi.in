; ITLabControl: Unicode installer so Vietnamese text is displayed correctly
Unicode true

!define APP_NAME "@ITLAB_PRODUCT_NAME@"
!define MASTER_NAME "@ITLAB_MASTER_NAME@"
!define CONFIGURATOR_NAME "@ITLAB_CONFIGURATOR_NAME@"
!define COMP_NAME "@ITLAB_ORGANIZATION_NAME@"
!define WEB_SITE "@ITLAB_WEBSITE@"
!define VERSION "@VERSION_MAJOR@.@VERSION_MINOR@.@VERSION_PATCH@.@VERSION_BUILD@"
!define COPYRIGHT "@ITLAB_COPYRIGHT@"
!define DESCRIPTION "${APP_NAME} Installer"
!define LICENSE_TXT "COPYING"
!define INSTALLER_NAME "@ITLAB_INSTALLER_BASENAME@-${VERSION}-@VEYON_WINDOWS_ARCH@-setup.exe"
!define MAIN_APP_EXE "veyon-master.exe"
!define INSTALL_TYPE "SetShellVarContext all"
!define REG_ROOT "HKLM"
; ITLabControl: own App Paths key (Veyon uses "veyon-master.exe"); InstallDirRegKey reads it, so sharing
; Veyon's key could make the installer default to Veyon's folder
!define REG_APP_PATH "Software\Microsoft\Windows\CurrentVersion\App Paths\itlabcontrol.exe"
!define UNINSTALL_PATH "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APP_NAME}"

######################################################################

VIProductVersion  "${VERSION}"
VIAddVersionKey "ProductName"  "${APP_NAME}"
VIAddVersionKey "CompanyName"  "${COMP_NAME}"
VIAddVersionKey "LegalCopyright"  "${COPYRIGHT}"
VIAddVersionKey "FileDescription"  "${DESCRIPTION}"
VIAddVersionKey "ProductVersion"  "${VERSION}"
VIAddVersionKey "FileVersion"  "${VERSION}"

######################################################################

SetCompressor /SOLID lzma
Name "${APP_NAME}"
Caption "${APP_NAME} ${VERSION}"
OutFile "${INSTALLER_NAME}"
BrandingText "${APP_NAME} ${VERSION}"
XPStyle on
InstallDirRegKey "${REG_ROOT}" "${REG_APP_PATH}" ""
InstallDir "$PROGRAMFILES64\@ITLAB_INSTALL_DIRNAME@"
ShowInstDetails hide
RequestExecutionLevel admin

######################################################################

!include "LogicLib.nsh"
!include "MUI2.nsh"
!include "FileFunc.nsh"

!define MUI_ABORTWARNING
!define MUI_UNABORTWARNING

!define MUI_WELCOMEFINISHPAGE_BITMAP "nsis/welcome-page.bmp"
!define MUI_UNWELCOMEFINISHPAGE_BITMAP "nsis/welcome-page.bmp"

!define MUI_ICON "nsis/installer.ico"
!define MUI_UNICON "nsis/uninstaller.ico"
!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_BITMAP "nsis/header.bmp"
!define MUI_HEADERIMAGE_RIGHT

!define MUI_LANGDLL_REGISTRY_ROOT "${REG_ROOT}"
!define MUI_LANGDLL_REGISTRY_KEY "${UNINSTALL_PATH}"
!define MUI_LANGDLL_REGISTRY_VALUENAME "Installer Language"

!insertmacro MUI_PAGE_WELCOME

!insertmacro MUI_PAGE_LICENSE "${LICENSE_TXT}"

!insertmacro MUI_PAGE_DIRECTORY

!insertmacro MUI_PAGE_COMPONENTS

!insertmacro MUI_PAGE_INSTFILES

!define MUI_FINISHPAGE_RUN
!define MUI_FINISHPAGE_RUN_TEXT "$(TXT_RUN_CONFIGURATOR)"
!define MUI_FINISHPAGE_RUN_FUNCTION "RunConfigurator"
!define MUI_FINISHPAGE_LINK "$(TXT_GITHUB_LINK)"
!define MUI_FINISHPAGE_LINK_LOCATION "${WEB_SITE}"

!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM

!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_UNPAGE_FINISH

; ITLabControl: Vietnamese (default) and English only
!insertmacro MUI_LANGUAGE "Vietnamese" ;first language is the default language
!insertmacro MUI_LANGUAGE "English"

!insertmacro MUI_RESERVEFILE_LANGDLL

######################################################################

!macro ITLAB_DROP_OLD_PORT GROUP KEY OLDVALUE
  ReadRegStr $R3 HKLM "SOFTWARE\ITLabControl\ITLabControl\${GROUP}" "${KEY}"
  ${If} $R3 == "${OLDVALUE}"
    DeleteRegValue HKLM "SOFTWARE\ITLabControl\ITLabControl\${GROUP}" "${KEY}"
  ${EndIf}
!macroend

Section "$(SEC_SERVICE_NAME)" SEC_SERVICE
SectionIn RO
${INSTALL_TYPE}
ClearErrors
ExecWait '"$INSTDIR\veyon-wcli.exe" service unregister'
${If} $0 != 0
  ExecWait '"$INSTDIR\veyon-ctl.exe" service unregister'
${EndIf}
Delete "$INSTDIR\*.dll"
Delete "$INSTDIR\*.exe"
Delete "$INSTDIR\plugins\*.dll"
RmDir /r "$INSTDIR\plugins"
RmDir /r "$INSTDIR\translations"
SetOverwrite on
SetOutPath "$INSTDIR"
# core components
File "veyon-server.exe"
File "veyon-service.exe"
File "veyon-configurator.exe"
File "veyon-cli.exe"
File "veyon-wcli.exe"
File "veyon-worker.exe"
File "*.dll"
File "LICENSE.TXT"
File "README.TXT"
# plugins
SetOutPath "$INSTDIR\plugins"
File "plugins/*.dll"
# translations
SetOutPath "$INSTDIR\translations"
File "translations/*.qm"
# QCA plugins
SetOutPath "$INSTDIR\crypto"
File "crypto/*.dll"
# Qt image format plugin
SetOutPath "$INSTDIR\imageformats"
File "imageformats/qjpeg.dll"
# Qt platform plugin
SetOutPath "$INSTDIR\platforms"
File "platforms/qwindows.dll"
SetOutPath "$INSTDIR\styles"
File "styles/*.dll"
# Qt TLS backend
SetOutPath "$INSTDIR\tls"
File "tls/qopensslbackend.dll"
# configuration
ExecWait '"$INSTDIR\veyon-wcli.exe" service register'
ExecWait '"$INSTDIR\veyon-wcli.exe" config set Network/FirewallExceptionEnabled 1'
ExecWait '"$INSTDIR\veyon-wcli.exe" config set Windows/SoftwareSASEnabled 1'
# disable forced guest logon as otherwise logon authentication fails
WriteRegDWORD ${REG_ROOT} "SYSTEM\CurrentControlSet\Control\Lsa"  "ForceGuest" "0"
${GetParameters} $R0
${GetOptions} $R0 "/ApplyConfig=" $R1
${If} $R1 != ""
  ClearErrors
  ExecWait '"$INSTDIR\veyon-wcli.exe" config import "$R1"' $0
  ${If} $0 != 0
	   MessageBox MB_OK|MB_ICONSTOP "$(TXT_CONFIG_IMPORT_FAILED)"
  ${EndIf}
${EndIf}
# ITLabControl: earlier builds used Veyon's default ports (11xxx). Configurations saved by
# those builds store the old values explicitly, which would keep ITLabControl on Veyon's ports.
# Remove a stored port only if it still equals Veyon's default, so the new 14xxx defaults apply;
# ports deliberately set to other values are kept.
SetRegView 64
!insertmacro ITLAB_DROP_OLD_PORT "Network" "VeyonServerPort" "11100"
!insertmacro ITLAB_DROP_OLD_PORT "Network" "VncServerPort" "11200"
!insertmacro ITLAB_DROP_OLD_PORT "Network" "FeatureWorkerManagerPort" "11300"
!insertmacro ITLAB_DROP_OLD_PORT "Network" "DemoServerPort" "11400"
!insertmacro ITLAB_DROP_OLD_PORT "WebAPI" "HttpServerPort" "11080"
SetRegView lastused
ExecWait '"$INSTDIR\veyon-wcli.exe" service start'
SectionEnd

Section "$(SEC_MASTER_NAME)" SEC_MASTER
${INSTALL_TYPE}
SetOutPath "$INSTDIR"
File "veyon-master.exe"

${GetParameters} $R0
${GetOptions} $R0 "/NoStartMenuFolder" $R1
${If} ${Errors}
CreateDirectory "$SMPROGRAMS\${APP_NAME}"
CreateShortCut "$SMPROGRAMS\${APP_NAME}\${MASTER_NAME}.lnk" "$INSTDIR\${MAIN_APP_EXE}"
${EndIf}
CreateShortCut "$DESKTOP\${MASTER_NAME}.lnk" "$INSTDIR\${MAIN_APP_EXE}"
SectionEnd

Section "$(SEC_INTERCEPTION_NAME)" SEC_INTERCEPTION
${INSTALL_TYPE}
SetOutPath "$INSTDIR\interception"
File "interception/*"
SectionEnd

Function RunConfigurator
	Exec '"$INSTDIR\veyon-configurator.exe"'
FunctionEnd


######################################################################

Function .onInit
!insertmacro MUI_LANGDLL_DISPLAY
${GetParameters} $R0
${GetOptions} $R0 "/NoMaster" $R1
${IfNot} ${Errors}
  !insertmacro UnselectSection ${SEC_MASTER}
${EndIf}
${GetOptions} $R0 "/NoInterception" $R1
${IfNot} ${Errors}
  !insertmacro UnselectSection ${SEC_INTERCEPTION}
${EndIf}
UserInfo::GetAccountType
pop $0
${If} $0 != "admin"
	MessageBox mb_iconstop "$(TXT_ADMIN_REQUIRED)"
	SetErrorLevel 740 ;ERROR_ELEVATION_REQUIRED
	Quit
${EndIf}
FunctionEnd

######################################################################

Section -Icons_Reg
SetOutPath "$INSTDIR"
WriteUninstaller "$INSTDIR\uninstall.exe"

${GetParameters} $R0
${GetOptions} $R0 "/NoStartMenuFolder" $R1
${If} ${Errors}
CreateDirectory "$SMPROGRAMS\${APP_NAME}"
CreateShortCut "$SMPROGRAMS\${APP_NAME}\${CONFIGURATOR_NAME}.lnk" "$INSTDIR\veyon-configurator.exe"
CreateShortCut "$SMPROGRAMS\${APP_NAME}\Uninstall ${APP_NAME}.lnk" "$INSTDIR\uninstall.exe"
WriteIniStr "$INSTDIR\${APP_NAME} website.url" "InternetShortcut" "URL" "${WEB_SITE}"
CreateShortCut "$SMPROGRAMS\${APP_NAME}\${APP_NAME} Website.lnk" "$INSTDIR\${APP_NAME} website.url"
${EndIf}

WriteRegStr ${REG_ROOT} "${REG_APP_PATH}" "" "$INSTDIR\${MAIN_APP_EXE}"
# ITLabControl: earlier versions wrote "App Paths\veyon-master.exe", which belongs to Veyon.
# Remove it only if it points to this installation, so an installed Veyon is not affected.
ReadRegStr $R2 ${REG_ROOT} "Software\Microsoft\Windows\CurrentVersion\App Paths\veyon-master.exe" ""
${If} $R2 == "$INSTDIR\${MAIN_APP_EXE}"
  DeleteRegKey ${REG_ROOT} "Software\Microsoft\Windows\CurrentVersion\App Paths\veyon-master.exe"
${EndIf}
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayName" "${APP_NAME}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "UninstallString" "$INSTDIR\uninstall.exe"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayIcon" "$INSTDIR\${MAIN_APP_EXE}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayVersion" "${VERSION}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "Publisher" "${COMP_NAME}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "URLInfoAbout" "${WEB_SITE}"
# ITLabControl: tell Windows to refresh cached icons (the .exe paths stay the same across versions)
System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
SectionEnd

######################################################################

Section Uninstall
${INSTALL_TYPE}

ExecWait '"$INSTDIR\veyon-wcli.exe" config set Service/SoftwareSASEnabled 0'
ExecWait '"$INSTDIR\veyon-wcli.exe" config set Network/FirewallExceptionEnabled 0'
ExecWait '"$INSTDIR\veyon-wcli.exe" service unregister'
# ITLabControl: the Interception driver is shared with Veyon - keep it if Veyon is still installed
ReadRegStr $R2 ${REG_ROOT} "Software\Microsoft\Windows\CurrentVersion\Uninstall\Veyon" "UninstallString"
${If} $R2 == ""
  ExecWait '"$INSTDIR\interception\install-interception.exe" /uninstall'
${EndIf}
# make sure the service is stopped and all file handles are released
Sleep 2000

${GetParameters} $R0
${GetOptions} $R0 "/ClearConfig" $R1
${IfNot} ${Errors}
	ExecWait '"$INSTDIR\veyon-wcli.exe" config clear'
${EndIf}

Delete "$INSTDIR\*.exe"
Delete "$INSTDIR\*.dll"
Delete "$INSTDIR\*.TXT"
Delete "$INSTDIR\*.url"
RmDir /r "$INSTDIR\crypto"
RmDir /r "$INSTDIR\imageformats"
RmDir /r "$INSTDIR\plugins"
RmDir /r "$INSTDIR\platforms"
RmDir /r "$INSTDIR\styles"
RmDir /r "$INSTDIR\tls"
RmDir /r "$INSTDIR\translations"
RmDir /r "$INSTDIR\interception"

RmDir "$INSTDIR"

Delete "$SMPROGRAMS\${APP_NAME}\${MASTER_NAME}.lnk"
Delete "$SMPROGRAMS\${APP_NAME}\${CONFIGURATOR_NAME}.lnk"
Delete "$SMPROGRAMS\${APP_NAME}\Uninstall ${APP_NAME}.lnk"
Delete "$SMPROGRAMS\${APP_NAME}\${APP_NAME} Website.lnk"
RmDir "$SMPROGRAMS\${APP_NAME}"

Delete "$DESKTOP\${MASTER_NAME}.lnk"

DeleteRegKey ${REG_ROOT} "${REG_APP_PATH}"
DeleteRegKey ${REG_ROOT} "${UNINSTALL_PATH}"
SectionEnd

######################################################################

Function un.onInit
!insertmacro MUI_UNGETLANGUAGE
FunctionEnd

######################################################################

LangString SEC_SERVICE_NAME ${LANG_ENGLISH} "${APP_NAME} Service"
LangString SEC_SERVICE_NAME ${LANG_VIETNAMESE} "Dịch vụ ${APP_NAME}"
LangString SEC_MASTER_NAME ${LANG_ENGLISH} "Teacher Console"
LangString SEC_MASTER_NAME ${LANG_VIETNAMESE} "Bảng điều khiển giáo viên"
LangString SEC_INTERCEPTION_NAME ${LANG_ENGLISH} "Interception driver"
LangString SEC_INTERCEPTION_NAME ${LANG_VIETNAMESE} "Driver khoá bàn phím/chuột (Interception)"
LangString DESC_SEC_SERVICE ${LANG_ENGLISH} "${APP_NAME} service and common files required on all computers"
LangString DESC_SEC_SERVICE ${LANG_VIETNAMESE} "Dịch vụ ${APP_NAME} và các file dùng chung, cần cài trên mọi máy"
LangString DESC_SEC_MASTER ${LANG_ENGLISH} "Teacher console for monitoring and controlling student computers"
LangString DESC_SEC_MASTER ${LANG_VIETNAMESE} "Bảng điều khiển giáo viên để giám sát và điều khiển máy học sinh (chỉ cài trên máy giáo viên)"
LangString DESC_SEC_INTERCEPTION ${LANG_ENGLISH} "Special input device driver required for intercepting keyboard shortcuts such as Ctrl+Alt+Del in screen lock mode"
LangString DESC_SEC_INTERCEPTION ${LANG_VIETNAMESE} "Driver đặc biệt để chặn các tổ hợp phím như Ctrl+Alt+Del khi khoá máy học sinh"
LangString TXT_RUN_CONFIGURATOR ${LANG_ENGLISH} "Run ${CONFIGURATOR_NAME} now"
LangString TXT_RUN_CONFIGURATOR ${LANG_VIETNAMESE} "Mở ${CONFIGURATOR_NAME} ngay"
LangString TXT_GITHUB_LINK ${LANG_ENGLISH} "${APP_NAME} on GitHub (based on Veyon)"
LangString TXT_GITHUB_LINK ${LANG_VIETNAMESE} "${APP_NAME} trên GitHub (phát triển từ Veyon)"
LangString TXT_ADMIN_REQUIRED ${LANG_ENGLISH} "Please run the installer with administrative rights!"
LangString TXT_ADMIN_REQUIRED ${LANG_VIETNAMESE} "Vui lòng chạy bộ cài với quyền quản trị (Run as administrator)!"
LangString TXT_CONFIG_IMPORT_FAILED ${LANG_ENGLISH} "Could not apply specified configuration file!"
LangString TXT_CONFIG_IMPORT_FAILED ${LANG_VIETNAMESE} "Không áp dụng được file cấu hình đã chỉ định!"

!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
!insertmacro MUI_DESCRIPTION_TEXT ${SEC_SERVICE} $(DESC_SEC_SERVICE)
!insertmacro MUI_DESCRIPTION_TEXT ${SEC_MASTER} $(DESC_SEC_MASTER)
!insertmacro MUI_DESCRIPTION_TEXT ${SEC_INTERCEPTION} $(DESC_SEC_INTERCEPTION)
!insertmacro MUI_FUNCTION_DESCRIPTION_END

